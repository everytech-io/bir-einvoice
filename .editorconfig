# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_imports_layout = *

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[gradlew]
end_of_line = lf

[*.{png,ico,icns,jar}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
